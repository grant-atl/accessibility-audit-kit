{
  "description": "Opt-in accessibility check feedback after editing a trusted project",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/skills/accessibility-checks/scripts/checks.py", "claude"],
            "timeout": 140
          }
        ]
      }
    ]
  }
}
